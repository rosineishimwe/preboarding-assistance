# Copy this file to server/.env and replace all values with your real local settings.
# Do not commit real passwords, tokens, or API keys.
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=preboarding_assistance
FRONTEND_ORIGIN=http://localhost:5173

# Email delivery configuration (optional, leave blank unless you have real SMTP credentials)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_ENABLED=false
